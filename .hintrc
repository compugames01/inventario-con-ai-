{
  "extends": [
    "development"
  ],
  "hints": {
    "apple-touch-icons": "off",
    "axe/forms": [
      "default",
      {
        "label": "off"
      }
    ],
    "no-inline-styles": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not and_ff <= 147",
    "not firefox <= 148",
    "not ios_saf <= 14.8",
    "not opera <= 125",
    "not safari <= 14.1"
  ]
}